# Azure Maps (subscription key — server-side ONLY, never expose to browser)
AZURE_MAPS_KEY=

# Azure AI Foundry project endpoint
# Format: https://<service-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=

# The name of your GPT-5-mini model deployment in Foundry
FOUNDRY_MODEL_DEPLOYMENT=

# Azure AD credentials (used for DefaultAzureCredential)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional: override CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: demo mode (set to "true" to enable clearly-labelled static demo data)
# DEMO_MODE=false
